# ==========================================================

def analyze_email():

    text = email_box.get(
        "1.0",
        tk.END
    ).strip()

    if not text:

        messagebox.showwarning(
            "Empty Email",
            "Please enter an email message first."
        )

        return

    category, spam_prob, ham_prob = model.predict(
        text
    )

    history.append({
        "text": text,
        "category": category,
        "spam": spam_prob,
        "ham": ham_prob
    })

    email_words = words(text)

    suspicious_words = {
        "free",
        "win",
        "winner",
        "won",
        "prize",
        "cash",
        "reward",
        "claim",
        "urgent",
        "offer",
        "bonus",
        "money",
        "lottery",
        "gift",
        "click",
        "buy",
        "selected",
        "congratulations"
    }

    found = []

    for word in email_words:

        if (
            word in suspicious_words
            and word not in found
        ):
            found.append(word)

    # ------------------------------------------------------
    # RESULT TITLE
    # ------------------------------------------------------

    if category == "Spam":

        result_title.config(
            text="SPAM DETECTED",
            fg=RED
        )

        result_subtitle.config(
            text="This message contains patterns associated with spam."
        )

    else:

        result_title.config(
            text="NOT SPAM",
            fg=GREEN
        )

        result_subtitle.config(
            text="This message is classified as normal email."
        )

    # ------------------------------------------------------
    # PROBABILITY LABELS
    # ------------------------------------------------------

    spam_label.config(
        text=f"Spam\n{spam_prob:.2f}%"
    )

    ham_label.config(
        text=f"Ham\n{ham_prob:.2f}%"
    )

    # ------------------------------------------------------
    # PROBABILITY BARS
    # ------------------------------------------------------

    spam_bar_bg.update_idletasks()
    ham_bar_bg.update_idletasks()

    spam_width = spam_bar_bg.winfo_width()
    ham_width = ham_bar_bg.winfo_width()

    spam_bar.place(
        x=0,
        y=0,
        width=max(
            1,
            int(spam_width * spam_prob / 100)
        ),
        height=16
    )

    ham_bar.place(
        x=0,
        y=0,
        width=max(
            1,
            int(ham_width * ham_prob / 100)
        ),
        height=16
    )

    # ------------------------------------------------------
    # SUSPICIOUS TERMS
    # ------------------------------------------------------

    if found:

        keyword_label.config(
            text=(
                "Suspicious Terms\n"
                + ", ".join(found)
            ),
            fg=RED
        )

    else:

        keyword_label.config(
            text=(
                "Suspicious Terms\n"
                "None detected"
            ),
            fg=GREEN
        )

    # ------------------------------------------------------
    # ANALYSIS
    # ------------------------------------------------------

    analysis_box.config(
        state="normal"
    )

    analysis_box.delete(
        "1.0",
        tk.END
    )

    analysis_box.insert(
        tk.END,
        "CLASSIFICATION\n"
    )

    analysis_box.insert(
        tk.END,
        "────────────────────────────\n"
    )

    analysis_box.insert(
        tk.END,
        f"Category: {category}\n"
    )

    analysis_box.insert(
        tk.END,
        f"Spam probability: {spam_prob:.2f}%\n"
    )

    analysis_box.insert(
        tk.END,
        f"Ham probability: {ham_prob:.2f}%\n\n"
    )

    analysis_box.insert(
        tk.END,
        "MESSAGE STATISTICS\n"
    )

    analysis_box.insert(
        tk.END,
        "────────────────────────────\n"
    )

    analysis_box.insert(
        tk.END,
        f"Total words: {len(email_words)}\n"
    )

    analysis_box.insert(
        tk.END,
        f"Unique words: {len(set(email_words))}\n"
    )

    analysis_box.insert(
        tk.END,
        f"Suspicious terms: {len(found)}\n\n"
    )

    analysis_box.insert(
        tk.END,
        "MODEL\n"
    )

    analysis_box.insert(
        tk.END,
        "────────────────────────────\n"
    )

    analysis_box.insert(
        tk.END,
        "Algorithm: Multinomial Naive Bayes\n"
