    ):

        category, spam, ham = model.predict(
            sample
        )

        box.insert(
            tk.END,
            f"TEST {number}\n"
            f"Email: {sample}\n"
            f"Prediction: {category}\n"
            f"Spam: {spam:.2f}%\n"
            f"Ham: {ham:.2f}%\n"
            + "-" * 55
            + "\n\n"
        )


# ==========================================================
# ADD TRAINING EMAIL
# ==========================================================

def add_training_email():

    window = tk.Toplevel(root)

    window.title(
        "Add Training Email"
    )

    window.geometry(
        "600x430"
    )

    window.minsize(
        450,
        330
    )

    window.configure(
        bg=WHITE
    )

    tk.Label(
        window,
        text="ADD TRAINING EMAIL",
        font=("Arial", 18, "bold"),
        bg=WHITE,
        fg=DARK
    ).pack(
        pady=15
    )

    box = scrolledtext.ScrolledText(
        window,
        height=7,
        font=("Arial", 10),
        wrap=tk.WORD
    )

    box.pack(
        fill="both",
        expand=True,
        padx=20,
        pady=5
    )

    category = tk.StringVar(
        value="Spam"
    )

    tk.Radiobutton(
        window,
        text="Spam",
        variable=category,
        value="Spam",
        bg=WHITE
    ).pack(
        pady=4
    )

    tk.Radiobutton(
        window,
        text="Ham / Not Spam",
        variable=category,
        value="Ham",
        bg=WHITE
    ).pack()

    def save():

        text = box.get(
            "1.0",
            tk.END
        ).strip()

        if not text:

            messagebox.showwarning(
                "Empty Email",
                "Please enter an email."
            )

            return

        if category.get() == "Spam":
            spam_emails.append(text)
        else:
            ham_emails.append(text)

        model.train()

        messagebox.showinfo(
            "Success",
            "Training email added and model retrained."
        )

        window.destroy()

    tk.Button(
        window,
        text="ADD & RETRAIN",
        command=save,
        bg=BLUE,
        fg=WHITE,
        font=("Arial", 9, "bold"),
        bd=0,
        padx=25,
        pady=9
    ).pack(
        pady=12
    )


