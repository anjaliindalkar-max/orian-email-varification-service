# ==========================================================
# TEXT PROCESSING
# ==========================================================

def words(text):
    return re.findall(r"[a-z0-9]+", text.lower())


# ==========================================================
# NAIVE BAYES
# ==========================================================

class NaiveBayes:

    def __init__(self):
        self.spam = Counter()
        self.ham = Counter()
        self.vocabulary = set()
        self.spam_docs = 0
        self.ham_docs = 0
        self.spam_total = 0
        self.ham_total = 0

    def train(self):

        self.spam.clear()
        self.ham.clear()
        self.vocabulary.clear()

        self.spam_docs = len(spam_emails)
        self.ham_docs = len(ham_emails)

        for email in spam_emails:
            w = words(email)
            self.spam.update(w)
            self.vocabulary.update(w)

        for email in ham_emails:
            w = words(email)
            self.ham.update(w)
            self.vocabulary.update(w)

        self.spam_total = sum(self.spam.values())
        self.ham_total = sum(self.ham.values())

    def predict(self, text):

        w = words(text)

        if not w:
            return "Unknown", 0.0, 100.0

        total_docs = self.spam_docs + self.ham_docs
        vocab = len(self.vocabulary)

        spam_score = math.log(
            self.spam_docs / total_docs
        )

        ham_score = math.log(
            self.ham_docs / total_docs
        )

        for word in w:

            spam_prob = (
                self.spam[word] + 1
            ) / (
                self.spam_total + vocab
            )

            ham_prob = (
                self.ham[word] + 1
            ) / (
                self.ham_total + vocab
            )

            spam_score += math.log(spam_prob)
            ham_score += math.log(ham_prob)

        highest = max(spam_score, ham_score)

        spam_exp = math.exp(
            spam_score - highest
        )

        ham_exp = math.exp(
            ham_score - highest
        )

        spam_percentage = (
            spam_exp /
            (spam_exp + ham_exp)
        ) * 100

        ham_percentage = 100 - spam_percentage

        if spam_score > ham_score:
            return (
                "Spam",
                spam_percentage,
                ham_percentage
            )

        return (
            "Ham",
            spam_percentage,
            ham_percentage
        )


